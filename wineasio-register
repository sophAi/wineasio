#!/bin/bash
# ==============================================================================
# wineasio-register: WineASIO Registration Script (Wine 11+ / WoW64 compatible)
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -f "$SCRIPT_DIR/install.sh" ]; then
    exec "$SCRIPT_DIR/install.sh" --register-only "$@"
else
    # Standalone registration logic if install.sh is not present
    WINEPREFIX="${WINEPREFIX:-$HOME/.wine}"
    
    if [ ! -d "$WINEPREFIX" ]; then
        wineboot -u || exit $?
    fi

    echo "[wineasio-register] Registering 64-bit WineASIO in $WINEPREFIX..."
    wine regsvr32 /s wineasio64.dll 2>/dev/null || true

    SYSWOW64="$WINEPREFIX/drive_c/windows/syswow64"
    if [ -f "$SYSWOW64/regsvr32.exe" ]; then
        echo "[wineasio-register] Registering 32-bit WineASIO (syswow64)..."
        wine "$SYSWOW64/regsvr32.exe" /s wineasio.dll 2>/dev/null || true
    else
        echo "[wineasio-register] Registering 32-bit WineASIO..."
        wine regsvr32 /s wineasio.dll 2>/dev/null || true
    fi

    echo "[wineasio-register] Registration complete."
fi
